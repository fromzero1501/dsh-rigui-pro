{
  "name": "dsh-rigui-pro",
  "version": "0.3.0",
  "description": "日晷 Pro (Rigui Pro) — a personal life workbench for DeepSeek Harness with an AI butler: tell it what's on today and it lays out the day; it also keeps track of water, meals, shower, hair wash and sleep, and reminds you when it's time",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "native/idlewatch.exe"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "life",
    "dashboard",
    "health",
    "finance",
    "habit",
    "schedule",
    "reminder",
    "assistant",
    "workbench"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fromzero1501/dsh-rigui-pro.git"
  },
  "homepage": "https://github.com/fromzero1501/dsh-rigui-pro#readme",
  "author": "fromzero1501",
  "contributors": [
    "AvenYQ (original dsh-rigui)"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "build:native": "go build -C native/idlewatch -ldflags=-w -o ../idlewatch.exe main.go"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
